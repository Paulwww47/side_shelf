root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,markdown,yml,yaml,json}]
indent_size = 2
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

[*.py]
indent_size = 4

[*.ps1]
indent_size = 4

[*.{cpp,h}]
indent_size = 4
